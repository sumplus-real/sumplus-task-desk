{
  "name": "sumplus-task-desk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "A clearly labeled Alexa+ procurement simulation with budget-bound, expiring confirmations.",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "esbuild src/browser.mjs --bundle --format=esm --platform=browser --target=es2022 --outfile=public/app.js",
    "catalogue:refresh": "node scripts/refresh-catalogue.mjs",
    "verify:mcp": "node scripts/verify-mcp.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "express": "5.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
